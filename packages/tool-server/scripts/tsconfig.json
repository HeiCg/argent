{
  // Typecheck the tool-server bench scripts (phase 3i). These `.ts` files run under
  // `tsx` (extensionless relative imports, `import.meta`, workspace package
  // `exports`), so they need bundler resolution + the `node` custom condition — the
  // package build's NodeNext config would reject their import style. They live
  // outside every other tsconfig (`src/**` only), so without this they were never
  // typechecked. Wired into CI via the `typecheck:bench-scripts` npm script.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["node"],
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  // Every bench `.ts` in this directory (the fixtures/ tree is JSON only). A
  // glob rather than a hand-kept list so a new bench script is typechecked here
  // and picked up by eslint's `parserOptions.project` automatically — a stale
  // list is what left bench-preflight.ts and bench-screen-graph.ts outside
  // every project and unparseable by the type-aware lint.
  "include": ["*.ts"]
}
